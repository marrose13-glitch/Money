<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Udostępnij lokalizację</title>
</head>
<body>
    <h1>Udostępnij swoją lokalizację</h1>
    <p>Kliknij przycisk poniżej i zezwól przeglądarce na dostęp do lokalizacji.</p>

    <button onclick="getLocation()">Udostępnij lokalizację</button>

    <p id="status"></p>

    <script>
        function getLocation() {
            const status = document.getElementById("status");

            if (!navigator.geolocation) {
                status.innerText = "Ta przeglądarka nie obsługuje lokalizacji.";
                return;
            }

            status.innerText = "Pobieram lokalizację...";

            navigator.geolocation.getCurrentPosition(
                function(position) {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;

                    status.innerHTML =
                        "Lokalizacja została udostępniona.<br>" +
                        "Szerokość: " + lat + "<br>" +
                        "Długość: " + lon + "<br><br>" +
                        '<a href="https://www.google.com/maps?q=' +
                        lat + ',' + lon +
                        '" target="_blank">Otwórz w Google Maps</a>';
                },
                function(error) {
                    status.innerText =
                        "Nie udzielono zgody na dostęp do lokalizacji.";
                }
            );
        }
    </script>
</body>
</html>
